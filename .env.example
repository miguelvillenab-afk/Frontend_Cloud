# API Gateway (prod) - HTTPS requerido para Amplify
VITE_API_GATEWAY_URL=https://xxxx.execute-api.us-east-1.amazonaws.com/prod

# DEV local: deja VACÍAS para usar el proxy de Vite (/api/users -> localhost:8000, etc.)
# definido en vite.config.ts. Mismo-origen = sin errores CORS.
# Solo usa URLs absolutas (http://localhost:8000) si el FastAPI tiene CORSMiddleware
# habilitado; si no, el navegador bloquea y el preflight devuelve 405.
# VITE_API_USERS_URL=http://localhost:8000
# VITE_API_PROPERTIES_URL=http://localhost:8081
# VITE_API_RESERVATIONS_URL=http://localhost:3000
# VITE_API_DASHBOARD_URL=http://localhost:8003
# VITE_API_ANALYTICS_URL=http://localhost:8004

# Mock fallback si microservicios no levantados
VITE_MOCK=false
